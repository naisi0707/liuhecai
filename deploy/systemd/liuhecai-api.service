[Unit]
Description=liuhecai Spring Boot API
After=network.target mysql.service mysqld.service
Wants=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/www/wwwroot/liuhecai
EnvironmentFile=/etc/liuhecai/api.env
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar /www/wwwroot/liuhecai/apps/api/target/liuhecai-api-0.0.1-SNAPSHOT.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
