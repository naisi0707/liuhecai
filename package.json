{
  "name": "liuhecai",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @liuhecai/web dev",
    "dev:admin": "pnpm --filter @liuhecai/admin dev",
    "dev:agent": "pnpm --filter @liuhecai/agent dev",
    "start:admin": "pnpm --filter @liuhecai/admin preview",
    "start:agent": "pnpm --filter @liuhecai/agent preview",
